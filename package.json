    "rewrite:recipe-copy": "esbuild scripts/rewrite-recipe-copy.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.rewrite-recipe-copy.mjs && node --env-file=.env.local scripts/.rewrite-recipe-copy.mjs",
    "classify:usage": "esbuild scripts/classify-ingredient-usage.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.classify-usage.mjs && node --env-file=.env.local scripts/.classify-usage.mjs"
