{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "lint": "eslint .",
    "start": "next start",
    "generate-types": "supabase gen types typescript --project-id [project-id] > lib/database.types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "usda:build": "esbuild scripts/usda-build.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.usda-build.mjs && node --env-file=.env.local scripts/.usda-build.mjs",
    "classify:drink-types": "esbuild scripts/classify-drink-types.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.classify-drink-types.mjs && node --env-file=.env.local scripts/.classify-drink-types.mjs",
    "recompute:categories:v7": "esbuild scripts/recompute-category-scores.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.recompute-categories-v7.mjs && node --env-file=.env.local scripts/.recompute-categories-v7.mjs",
    "recompute:categories": "esbuild scripts/recompute-categories.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.recompute-categories.mjs && node --env-file=.env.local scripts/.recompute-categories.mjs",
    "vectorise": "node --env-file=.env.local scripts/vectorise.mjs",
    "score-supports": "node --env-file=.env.local scripts/score-supports.mjs",
    "list-models": "node --env-file=.env.local scripts/list-models.mjs",
    "classify:tiers": "esbuild scripts/classify-ingredient-tiers.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.classify-tiers.mjs && node --env-file=.env.local scripts/.classify-tiers.mjs",
    "test:unit": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration",
    "preview:categories": "esbuild scripts/preview-category-scores.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.preview-categories.mjs && node --env-file=.env.local scripts/.preview-categories.mjs",
